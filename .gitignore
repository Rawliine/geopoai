.env

# Terraform local state (may contain secrets from startup script interpolation)
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/.terraform/
output/
tmp/
data/
# Provisioned asset trees (lockfile: assets/manifest.json)
assets/icons/
assets/fonts/
assets/models/
assets/sfx/*
!assets/sfx/palette.json
# Manim LaTeX/SVG cache (regenerated per render)
media/

# Python bytecode (regenerated on import; never source-of-truth)
__pycache__/
*.pyc
*.pyo

# Claude Code workspace (per-developer plans, memory, settings)
.claude/

# MCP server configuration (per-developer; may contain auth/local paths)
.mcp.json