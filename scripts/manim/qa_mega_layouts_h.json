{
  "renderer": "manim",
  "format": "horizontal",
  "quality": "preview",
  "scene": {
    "layout": "split",
    "duration": 35,
    "theme": "dark"
  },
  "slots": {
    "left": {
      "at": 0.0,
      "action": "showPayoffMatrix",
      "params": {
        "id": "pd",
        "size": "small",
        "players": [
          { "name": "A", "color": "actor_a" },
          { "name": "B", "color": "actor_b" }
        ],
        "strategies": [["C", "D"], ["C", "D"]],
        "cells": [
          [{ "a": 3, "b": 3 }, { "a": 0, "b": 5 }],
          [{ "a": 5, "b": 0 }, { "a": 1, "b": 1 }]
        ],
        "timing": "slow", "effect": "level-by-level"
      }
    },
    "right": {
      "at": 0.5,
      "action": "showBarChart",
      "params": {
        "id": "bars",
        "size": "small",
        "data": [
          { "label": "Coop", "value": 3, "color": "actor_a" },
          { "label": "Defect", "value": 5, "color": "actor_b" }
        ],
        "y_axis": { "min": 0, "max": 6, "ticks": 4, "label": "Payoff" },
        "x_axis": { "label": "Strategy" },
        "value_format": "int", "show_value_labels": true,
        "timing": "slow", "effect": "count-up"
      }
    }
  },
  "overlays": [
    { "at": 6.0, "action": "showCalloutBox",
      "params": { "id": "cb-pd-above", "text": "Pareto-inferior equilibrium.",
        "anchor": "above:pd", "width": 4.0,
        "style": "neon", "color": "highlight", "timing": "normal" } },
    { "at": 11.0, "action": "removeComponent",
      "params": { "target": "cb-pd-above", "effect": "fade-out", "timing": "fast" } },

    { "at": 12.0, "action": "showCalloutBox",
      "params": { "id": "cb-bars-above", "text": "Defect dominates in payoff.",
        "anchor": "above:bars", "width": 4.0,
        "style": "glass", "color": "actor_b", "timing": "normal" } },
    { "at": 17.0, "action": "removeComponent",
      "params": { "target": "cb-bars-above", "effect": "fade-out", "timing": "fast" } },

    { "at": 18.0, "action": "highlightCell",
      "params": { "id": "hl-ne", "target": "pd", "index": [1, 1], "color": "highlight", "timing": "fast" } },
    { "at": 19.0, "action": "showCalloutBox",
      "params": { "id": "cb-pd-below", "text": "Mutual defection is the equilibrium.",
        "anchor": "below:pd", "width": 4.0,
        "style": "card", "timing": "normal" } },
    { "at": 24.0, "action": "removeComponent",
      "params": { "target": "cb-pd-below", "effect": "fade-out", "timing": "fast" } },

    { "at": 25.0, "action": "removeComponent",
      "params": { "target": "pd", "effect": "fade-out", "timing": "normal" } },
    { "at": 26.0, "action": "removeComponent",
      "params": { "target": "bars", "effect": "fade-out", "timing": "normal" } }
  ],
  "timeline": []
}
