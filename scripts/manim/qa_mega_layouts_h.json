{
  "renderer": "manim",
  "format": "horizontal",
  "quality": "preview",
  "scene": {
    "layout": "split",
    "duration": 60,
    "theme": "dark"
  },
  "slots": {
    "left": {
      "at": 0.0,
      "action": "showPayoffMatrix",
      "params": {
        "id": "pd-left",
        "size": "small",
        "players": [
          { "name": "A", "color": "actor_a" },
          { "name": "B", "color": "actor_b" }
        ],
        "strategies": [["C", "D"], ["C", "D"]],
        "cells": [
          [{ "a": 3, "b": 3 }, { "a": 0, "b": 5 }],
          [{ "a": 5, "b": 0 }, { "a": 1, "b": 1 }]
        ],
        "timing": "slow", "effect": "level-by-level"
      }
    },
    "right": {
      "at": 0.5,
      "action": "showBarChart",
      "params": {
        "id": "bars-right",
        "size": "small",
        "data": [
          { "label": "Coop", "value": 3, "color": "actor_a" },
          { "label": "Defect", "value": 5, "color": "actor_b" }
        ],
        "y_axis": { "min": 0, "max": 6, "ticks": 4, "label": "Payoff" },
        "x_axis": { "label": "Strategy" },
        "value_format": "int", "show_value_labels": true,
        "timing": "slow", "effect": "count-up"
      }
    }
  },
  "overlays": [
    { "at": 5.0, "action": "showCalloutBox",
      "params": { "id": "cb-above", "text": "Above the matrix.",
        "anchor": "above:pd-left", "width": 3.5,
        "style": "neon", "color": "highlight", "timing": "normal" } },
    { "at": 9.0, "action": "removeComponent",
      "params": { "target": "cb-above", "effect": "fade-out", "timing": "fast" } },

    { "at": 10.0, "action": "showCalloutBox",
      "params": { "id": "cb-below", "text": "Below the matrix.",
        "anchor": "below:pd-left", "width": 3.5,
        "style": "card", "timing": "normal" } },
    { "at": 14.0, "action": "removeComponent",
      "params": { "target": "cb-below", "effect": "fade-out", "timing": "fast" } },

    { "at": 15.0, "action": "showCalloutBox",
      "params": { "id": "cb-inside", "text": "Inside (overlay).",
        "anchor": "inside:pd-left", "width": 3.0,
        "style": "glass", "color": "highlight", "timing": "normal" } },
    { "at": 19.0, "action": "removeComponent",
      "params": { "target": "cb-inside", "effect": "fade-out", "timing": "fast" } },

    { "at": 20.0, "action": "showCalloutBox",
      "params": { "id": "cb-cross", "text": "Cross-slot — left points to right.",
        "anchor": "above:bars-right", "width": 4.0,
        "style": "bracket", "color": "actor_c", "timing": "normal" } },
    { "at": 25.0, "action": "removeComponent",
      "params": { "target": "cb-cross", "effect": "fade-out", "timing": "fast" } },

    { "at": 26.0, "action": "highlightCell",
      "params": { "id": "hl-cell", "target": "pd-left", "index": [1, 1], "color": "highlight", "timing": "fast" } },
    { "at": 28.0, "action": "showCalloutBox",
      "params": { "id": "cb-multi-a", "text": "Multiple callouts at once.",
        "anchor": "below:pd-left", "width": 3.0,
        "style": "neon", "color": "actor_a", "timing": "normal" } },
    { "at": 29.0, "action": "showCalloutBox",
      "params": { "id": "cb-multi-b", "text": "Both visible simultaneously.",
        "anchor": "below:bars-right", "width": 3.0,
        "style": "neon", "color": "actor_b", "timing": "normal" } },
    { "at": 34.0, "action": "removeComponent",
      "params": { "target": "cb-multi-a", "effect": "fade-out", "timing": "fast" } },
    { "at": 34.5, "action": "removeComponent",
      "params": { "target": "cb-multi-b", "effect": "fade-out", "timing": "fast" } },

    { "at": 36.0, "action": "removeComponent",
      "params": { "target": "pd-left", "effect": "fade-out", "timing": "normal" } },
    { "at": 37.0, "action": "removeComponent",
      "params": { "target": "bars-right", "effect": "fade-out", "timing": "normal" } }
  ],
  "timeline": []
}
