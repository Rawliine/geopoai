{
  "renderer": "manim",
  "format": "horizontal",
  "quality": "preview",
  "scene": {
    "layout": "title-body",
    "duration": 30,
    "theme": "dark"
  },
  "slots": {
    "title": {
      "at": 0.0,
      "action": "showTextCard",
      "params": {
        "id": "title",
        "text": "Roles + Restaging",
        "size": "title",
        "timing": "slow",
        "effect": "fade-in",
        "role": "primary"
      }
    },
    "body": {
      "at": 1.0,
      "action": "showStatBlock",
      "params": {
        "id": "k-loss",
        "value": 1200000,
        "label": "Annual loss",
        "value_format": "currency",
        "symbol": "$",
        "suffix": "auto",
        "size": "large",
        "color": "actor_a",
        "timing": "normal",
        "effect": "count-up",
        "role": "hero"
      }
    }
  },
  "overlays": [
    { "at": 11.0, "action": "setRole",
      "params": { "target": "k-loss", "role": "supporting", "timing": "fast" } },

    { "at": 14.0, "action": "showCalloutBox",
      "params": { "id": "callout-defect",
        "text": "Cooperation has eroded over time.",
        "subject": "k-loss",
        "width": 3.0,
        "style": "neon",
        "timing": "normal" } },

    { "at": 19.0, "action": "removeComponent",
      "params": { "target": "callout-defect", "effect": "fade-out", "timing": "fast" } },

    { "at": 20.0, "action": "setRole",
      "params": { "target": "k-loss", "role": "hero", "timing": "normal" } },

    { "at": 23.0, "action": "setRole",
      "params": { "target": "k-loss", "role": "ambient", "timing": "normal" } },

    { "at": 26.0, "action": "removeComponent",
      "params": { "target": "k-loss", "effect": "dissolve", "timing": "normal" } }
  ],
  "timeline": []
}
