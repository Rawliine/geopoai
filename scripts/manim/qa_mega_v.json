{
  "renderer": "manim",
  "format": "vertical",
  "quality": "preview",
  "scene": {
    "layout": "title-body",
    "duration": 55,
    "theme": "dark"
  },
  "slots": {
    "title": {
      "at": 0.0,
      "action": "showTextCard",
      "params": {
        "id": "title",
        "text": "Phase 2.0 QA — Vertical",
        "size": "title",
        "timing": "slow",
        "effect": "fade-in"
      }
    },
    "body": {
      "at": 1.0,
      "action": "showTextCard",
      "params": {
        "id": "intro",
        "text": "Three callout styles, one component per beat.",
        "size": "body",
        "timing": "slow",
        "effect": "fade-in"
      }
    }
  },
  "overlays": [
    { "at": 4.5, "action": "removeComponent",
      "params": { "target": "intro", "effect": "fade-out", "timing": "fast" } },

    { "at": 5.5, "action": "showStatBlock",
      "params": { "id": "stat-1", "value": 42.3, "label": "Cooperation rate",
        "unit": "%", "value_format": "decimal", "decimals": 1,
        "color": "actor_a", "size": "medium",
        "trend": { "delta": -7.5, "direction": "down" },
        "sparkline": [60, 55, 52, 48, 45, 43, 42],
        "timing": "slow", "effect": "count-up" } },
    { "at": 9.5, "action": "showCalloutBox",
      "params": { "id": "cb-stat", "text": "Defection is steadily eroding cooperation.",
        "anchor": "above:stat-1", "width": 5.0,
        "style": "neon", "color": "actor_a", "timing": "normal" } },
    { "at": 14.0, "action": "removeComponent",
      "params": { "target": "cb-stat", "effect": "fade-out", "timing": "fast" } },
    { "at": 14.5, "action": "removeComponent",
      "params": { "target": "stat-1", "effect": "fade-out", "timing": "normal" } },

    { "at": 16.0, "action": "showBarChart",
      "params": { "id": "bars", "size": "small",
        "data": [
          { "label": "C, C", "value": 3, "color": "positive" },
          { "label": "C, D", "value": 0, "color": "negative" },
          { "label": "D, C", "value": 5, "color": "actor_a" },
          { "label": "D, D", "value": 1, "color": "neutral" }
        ],
        "y_axis": { "min": 0, "max": 6, "ticks": 4, "label": "Payoff" },
        "x_axis": { "label": "Outcome" },
        "value_format": "int", "show_value_labels": true,
        "timing": "slow", "effect": "count-up" } },
    { "at": 22.0, "action": "showCalloutBox",
      "params": { "id": "cb-bars", "text": "Mutual cooperation maximises joint payoff.",
        "anchor": "above:bars", "width": 5.0,
        "style": "glass", "color": "highlight", "timing": "normal" } },
    { "at": 27.0, "action": "removeComponent",
      "params": { "target": "cb-bars", "effect": "fade-out", "timing": "fast" } },
    { "at": 27.5, "action": "removeComponent",
      "params": { "target": "bars", "effect": "fade-out", "timing": "normal" } },

    { "at": 29.0, "action": "showPayoffMatrix",
      "params": { "id": "pd", "size": "small",
        "players": [
          { "name": "P1", "color": "actor_a" },
          { "name": "P2", "color": "actor_b" }
        ],
        "strategies": [["C", "D"], ["C", "D"]],
        "cells": [
          [{ "a": 3, "b": 3 }, { "a": 0, "b": 5 }],
          [{ "a": 5, "b": 0 }, { "a": 1, "b": 1 }]
        ],
        "timing": "slow", "effect": "level-by-level" } },
    { "at": 34.5, "action": "showCalloutBox",
      "params": { "id": "cb-pd", "text": "Each player's dominant strategy is to defect.",
        "anchor": "below:pd", "width": 5.0,
        "style": "card", "timing": "normal" } },
    { "at": 38.5, "action": "highlightCell",
      "params": { "id": "hl-ne", "target": "pd", "index": [1, 1], "color": "highlight", "timing": "fast" } },
    { "at": 40.0, "action": "bestResponseArrow",
      "params": { "id": "arr-a", "target": "pd", "from": [0, 0], "to": [1, 0], "actor": "actor_a", "timing": "normal" } },
    { "at": 42.0, "action": "crossOut",
      "params": { "id": "x-row0", "target": "pd", "axis": "row", "index": 0, "style": "dashed", "timing": "normal" } },

    { "at": 47.0, "action": "removeComponent",
      "params": { "target": "cb-pd", "effect": "fade-out", "timing": "fast" } },
    { "at": 47.5, "action": "removeComponent",
      "params": { "target": "pd", "effect": "fade-out", "timing": "normal" } },

    { "at": 50.0, "action": "showTextCard",
      "params": { "id": "outro", "text": "QA tour complete.",
        "size": "body", "timing": "slow", "effect": "fade-in" } },
    { "at": 54.0, "action": "removeComponent",
      "params": { "target": "outro", "effect": "dissolve", "timing": "fast" } }
  ],
  "timeline": []
}
