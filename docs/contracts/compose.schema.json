{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geopoai.local/contracts/compose.schema.json",
  "title": "Episode compose specification",
  "description": "Clip assembly order, transitions, audio inputs, and export profiles.",
  "type": "object",
  "required": ["episode_id", "clips", "transitions", "audio", "export"],
  "additionalProperties": false,
  "properties": {
    "episode_id": { "type": "string", "minLength": 1 },
    "clips": {
      "type": "array",
      "items": { "$ref": "#/$defs/clip_ref" },
      "minItems": 1
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" }
    },
    "audio": { "$ref": "#/$defs/audio_inputs" },
    "export": { "$ref": "#/$defs/export_block" },
    "flags": { "$ref": "#/$defs/compose_flags" },
    "media_overlays": {
      "type": "array",
      "description": "W26 — screen-region media composited over the assembled timeline (post). Times are episode-time seconds; rect is in assembled-frame pixels.",
      "items": { "$ref": "#/$defs/media_overlay" }
    }
  },
  "$defs": {
    "clip_ref": {
      "type": "object",
      "required": ["clip_id", "path", "offset_s"],
      "additionalProperties": false,
      "properties": {
        "clip_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "offset_s": { "type": "number", "minimum": 0 },
        "events_path": { "type": "string" },
        "layout_path": { "type": "string" }
      }
    },
    "transition_type": {
      "type": "string",
      "enum": ["cut", "crossfade", "whoosh"]
    },
    "transition": {
      "type": "object",
      "required": ["after_clip_id", "type"],
      "additionalProperties": false,
      "properties": {
        "after_clip_id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/transition_type" },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds; required for crossfade/whoosh, ignored for cut."
        }
      }
    },
    "audio_inputs": {
      "type": "object",
      "required": ["vo"],
      "additionalProperties": false,
      "properties": {
        "vo": { "type": "string", "minLength": 1 },
        "bed": { "type": "string" }
      }
    },
    "export_profile": {
      "type": "string",
      "enum": ["yt_long", "shorts"]
    },
    "export_block": {
      "type": "object",
      "required": ["profiles"],
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/export_profile" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "compose_flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captions": { "type": "boolean" },
        "sound": { "type": "boolean" },
        "grade": { "type": "boolean" },
        "media": { "type": "boolean" }
      }
    },
    "media_overlay": {
      "type": "object",
      "required": ["src", "start", "end"],
      "additionalProperties": false,
      "description": "One screen-region media box. Provide either a named `region` or an explicit pixel `rect`.",
      "properties": {
        "id": { "type": "string" },
        "src": { "type": "string", "minLength": 1, "description": "Image or video path." },
        "region": {
          "type": "string",
          "enum": ["top", "bottom", "lower-third"],
          "description": "Named screen region; resolved to a pixel rect at the assembled frame size."
        },
        "rect": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, w, h] in assembled-frame pixels (overrides region)."
        },
        "start": { "type": "number", "minimum": 0, "description": "Episode-time seconds." },
        "end": { "type": "number", "minimum": 0, "description": "Episode-time seconds." },
        "fit": { "type": "string", "enum": ["contain"], "description": "Contain-fit only (letterboxed, no stretch)." },
        "border": { "type": "boolean", "description": "Draw the token-styled border (default false)." },
        "caption": { "type": "string", "description": "Optional caption rendered under the box." }
      }
    }
  }
}
