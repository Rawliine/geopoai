# Local Terraform clutter (never commit .terraform/)
.terraform/

# Crash diagnostics
crash.log
crash.*.log

# Local state (may contain secrets — never commit; use remote backend for teams)
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Local overrides experiments
override.tf
*_override.tf
secrets.auto.tfvars
*-secrets.tfvars
