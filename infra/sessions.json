{
  "gpu_hourly_usd": {
    "_note": "Fallback only — status uses GET /v1/instance-types price_per_hour / spot_price when up runs"
  },
  "storage": {
    "models_marker": "/mnt/models/.geopoai_download_complete",
    "default_volume_size_gb": 280,
    "volume_monthly_usd_per_gb": 0.10
  },
  "gpu_profiles": {
    "h100_spot": {
      "instance_type": "1H100.80S.30V",
      "use_spot": true,
      "image_preference": ["ubuntu-24.04-cuda-13.0-open-docker"],
      "label": "H100 SXM5 spot — production batch (best)"
    },
    "a6000_spot": {
      "instance_type": "1A6000.10V",
      "use_spot": true,
      "image_preference": ["ubuntu-22.04-cuda-12.4-docker"],
      "label": "A6000 spot — inference fallback"
    },
    "a100_fin03_ondemand": {
      "instance_type": "1A100.22V",
      "use_spot": false,
      "location": "FIN-03",
      "image_preference": ["ubuntu-22.04-cuda-12.4-docker"],
      "label": "A100 FIN-03 on-demand — alternate region"
    },
    "v100_ondemand": {
      "instance_type": "1V100.6V",
      "use_spot": false,
      "image_preference": ["ubuntu-22.04-cuda-12.4-docker"],
      "label": "V100 on-demand — setup / cheapest (worst)"
    }
  },
  "workloads": {
    "comfyui": {
      "tfvars": [
        "workloads/comfyui.tfvars",
        "workloads/comfyui_production.tfvars"
      ],
      "health": {
        "type": "http",
        "port": 8188,
        "path": "/"
      },
      "env_export": "BROLL_COMFYUI_URL",
      "default_gpu_profile": "1H100.80S.30V",
      "gpu_preference": [
        "h100_spot",
        "a6000_spot",
        "a100_fin03_ondemand",
        "v100_ondemand"
      ],
      "idle_minutes": 30,
      "max_session_hours": 8
    },
    "comfyui_setup": {
      "tfvars": ["workloads/comfyui.tfvars"],
      "health": {
        "type": "http",
        "port": 8188,
        "path": "/"
      },
      "env_export": "BROLL_COMFYUI_URL",
      "default_gpu_profile": "1V100.6V",
      "gpu_preference": [
        "v100_ondemand",
        "a6000_spot",
        "a100_fin03_ondemand"
      ],
      "idle_minutes": 60,
      "max_session_hours": 6
    },
    "blender_render": {
      "tfvars": ["workloads/blender_render.tfvars"],
      "health": {
        "type": "ssh"
      },
      "env_export": null,
      "default_gpu_profile": "1H100.80S.30V",
      "gpu_preference": ["h100_spot", "a6000_spot", "a100_fin03_ondemand"],
      "idle_minutes": 20,
      "max_session_hours": 4
    },
    "lora_train": {
      "tfvars": ["workloads/lora_train.tfvars"],
      "health": {
        "type": "ssh"
      },
      "env_export": null,
      "default_gpu_profile": "1H100.80S.30V",
      "gpu_preference": ["h100_spot", "a6000_spot", "a100_fin03_ondemand"],
      "idle_minutes": 15,
      "max_session_hours": 16
    }
  }
}
