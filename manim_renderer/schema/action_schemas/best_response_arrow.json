{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bestResponseArrow.params",
  "description": "Draw an arrow between two PayoffMatrix cells, colored by actor.",
  "type": "object",
  "required": ["target", "from", "to", "actor"],
  "properties": {
    "id":     { "$ref": "../scene_schema.json#/definitions/id_string" },
    "target": { "$ref": "../scene_schema.json#/definitions/id_string" },
    "from": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0, "maximum": 5 }
    },
    "to": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0, "maximum": 5 }
    },
    "actor":  { "$ref": "../scene_schema.json#/definitions/color_role" },
    "timing": { "$ref": "../scene_schema.json#/definitions/timing_name" }
  },
  "additionalProperties": false
}
