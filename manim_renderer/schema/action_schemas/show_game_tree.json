{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showGameTree.params",
  "description": "Recursive game tree. Horizontal: root left, grows L→R. Vertical: root top, grows T→B with depth cap.",
  "type": "object",
  "required": ["id", "nodes"],
  "properties": {
    "id":    { "$ref": "../scene_schema.json#/definitions/id_string" },
    "nodes": { "$ref": "#/definitions/tree_node" },
    "size":  { "$ref": "../scene_schema.json#/definitions/size_role" },
    "max_depth": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8,
      "description": "Vertical-format depth cap (default 4). Children past this depth are not rendered."
    },
    "anchor": { "$ref": "../scene_schema.json#/definitions/anchor_string" },
    "timing": { "$ref": "../scene_schema.json#/definitions/timing_name" },
    "effect": {
      "enum": ["fade-in", "level-by-level"]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "tree_node": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label":    { "type": "string", "minLength": 1, "maxLength": 32 },
        "edge":     { "type": "string", "maxLength": 16,
                      "description": "Label on the edge from PARENT to this node." },
        "color":    { "$ref": "../scene_schema.json#/definitions/color_role" },
        "children": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/definitions/tree_node" }
        }
      },
      "additionalProperties": false
    }
  }
}
