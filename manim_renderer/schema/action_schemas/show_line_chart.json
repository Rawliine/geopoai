{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showLineChart.params",
  "description": "Multi-series continuous-x line chart with themed axes.",
  "type": "object",
  "required": ["id", "series"],
  "properties": {
    "id": { "$ref": "../scene_schema.json#/definitions/id_string" },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["points"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 24 },
          "color": { "$ref": "../scene_schema.json#/definitions/color_role" },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 128,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" },
              "description": "[x, y] pair. Array form (not {x,y}) to avoid collision with the global coords-banned check."
            }
          }
        },
        "additionalProperties": false
      }
    },
    "size": { "$ref": "../scene_schema.json#/definitions/size_role" },
    "value_format": {
      "$ref": "../scene_schema.json#/definitions/value_format",
      "description": "Format for y-axis tick labels."
    },
    "x_format": {
      "$ref": "../scene_schema.json#/definitions/value_format",
      "description": "Format for x-axis tick labels (default 'int')."
    },
    "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
    "symbol":   { "type": "string", "maxLength": 4 },
    "suffix":   { "enum": ["K", "M", "B", "auto"] },
    "show_points": { "type": "boolean" },
    "x_axis": {
      "type": "object",
      "properties": {
        "min":   { "type": "number" },
        "max":   { "type": "number" },
        "ticks": { "type": "integer", "minimum": 2, "maximum": 12 },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "y_axis": {
      "type": "object",
      "properties": {
        "min":   { "type": "number" },
        "max":   { "type": "number" },
        "ticks": { "type": "integer", "minimum": 2, "maximum": 12 },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "anchor": { "$ref": "../scene_schema.json#/definitions/anchor_string" },
    "timing": { "$ref": "../scene_schema.json#/definitions/timing_name" },
    "effect": {
      "enum": ["fade-in", "draw-out", "level-by-level"]
    }
  },
  "additionalProperties": false
}
