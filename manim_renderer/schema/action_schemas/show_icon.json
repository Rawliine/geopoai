{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showIcon.params",
  "type": "object",
  "required": ["id", "icon"],
  "properties": {
    "id":     { "$ref": "../scene_schema.json#/definitions/id_string" },
    "icon":   { "type": "string", "minLength": 1,
                "description": "Glyph name. Bare name -> lucide pack (e.g. 'shield'); 'flag:<cc>' -> circle-flags (e.g. 'flag:ma')." },
    "color":  { "$ref": "../scene_schema.json#/definitions/color_role" },
    "glow":   { "type": "boolean" },
    "size":   { "$ref": "../scene_schema.json#/definitions/size_role" },
    "timing": { "$ref": "../scene_schema.json#/definitions/timing_name" },
    "effect": { "$ref": "../scene_schema.json#/definitions/entrance_effect" },
    "role":   { "$ref": "../scene_schema.json#/definitions/role_name" },
    "slot":   { "$ref": "../scene_schema.json#/definitions/slot_name" },
    "anchor": { "$ref": "../scene_schema.json#/definitions/anchor_string" }
  },
  "additionalProperties": false
}
