{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showCalloutBox.params",
  "description": "Text bubble + optional leader line to an anchor target or subject. Either `anchor` or `subject` must be present (anchor is the Phase 1 explicit form; subject is the Phase 2 solver-driven form).",
  "type": "object",
  "required": ["id", "text"],
  "anyOf": [
    { "required": ["anchor"] },
    { "required": ["subject"] }
  ],
  "properties": {
    "id":      { "$ref": "../scene_schema.json#/definitions/id_string" },
    "text":    { "type": "string", "minLength": 1, "maxLength": 280 },
    "anchor":  { "$ref": "../scene_schema.json#/definitions/anchor_string" },
    "subject": { "$ref": "../scene_schema.json#/definitions/subject_string" },
    "width":   { "type": "number", "minimum": 1.0, "maximum": 8.0 },
    "arrow":   { "type": "boolean" },
    "color":   { "$ref": "../scene_schema.json#/definitions/color_role" },
    "style":   { "$ref": "../scene_schema.json#/definitions/callout_style" },
    "timing":  { "$ref": "../scene_schema.json#/definitions/timing_name" },
    "effect":  { "$ref": "../scene_schema.json#/definitions/entrance_effect" },
    "role":    { "$ref": "../scene_schema.json#/definitions/role_name" }
  },
  "additionalProperties": false
}
