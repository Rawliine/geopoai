{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showTextCard.params",
  "type": "object",
  "required": ["id", "text"],
  "properties": {
    "id":     { "$ref": "../scene_schema.json#/definitions/id_string" },
    "text":   { "type": "string", "minLength": 1 },
    "size":   { "enum": ["title", "body", "label", "caption"] },
    "timing": { "$ref": "../scene_schema.json#/definitions/timing_name" },
    "effect": { "enum": ["fade-in"] },
    "role":   { "$ref": "../scene_schema.json#/definitions/role_name" }
  },
  "additionalProperties": false
}
