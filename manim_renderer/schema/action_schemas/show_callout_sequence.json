{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showCalloutSequence.params",
  "description": "Sequence of callouts that play one at a time. Validator counts the sequence as one annotation at any moment; the sequence's id can be removeComponent'd to cancel mid-stream.",
  "type": "object",
  "required": [
    "id",
    "callouts"
  ],
  "properties": {
    "id": {
      "$ref": "../scene_schema.json#/definitions/id_string"
    },
    "callouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "anyOf": [
          {
            "required": [
              "anchor"
            ]
          },
          {
            "required": [
              "subject"
            ]
          }
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "anchor": {
            "$ref": "../scene_schema.json#/definitions/anchor_string"
          },
          "subject": {
            "$ref": "../scene_schema.json#/definitions/subject_string"
          },
          "width": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 8.0
          },
          "arrow": {
            "type": "boolean"
          },
          "color": {
            "$ref": "../scene_schema.json#/definitions/color_role"
          }
        },
        "additionalProperties": false
      }
    },
    "hold_each": {
      "$ref": "../scene_schema.json#/definitions/timing_name"
    },
    "transition": {
      "$ref": "../scene_schema.json#/definitions/timing_name"
    },
    "style": {
      "$ref": "../scene_schema.json#/definitions/callout_style"
    },
    "timing": {
      "$ref": "../scene_schema.json#/definitions/timing_name"
    },
    "role": {
      "$ref": "../scene_schema.json#/definitions/role_name"
    },
    "slot": {
      "$ref": "../scene_schema.json#/definitions/slot_name"
    }
  },
  "additionalProperties": false
}
