{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showMedia.params",
  "type": "object",
  "required": ["id", "src"],
  "properties": {
    "id":          { "$ref": "../scene_schema.json#/definitions/id_string" },
    "src":         { "type": "string", "minLength": 1,
                     "description": "Image or video path: absolute, repo-root relative, or bare name under assets/images/ or assets/videos/." },
    "fit":         { "enum": ["contain", "cover"], "default": "contain",
                     "description": "contain = letterboxed fit inside; cover = fill frame with matte crop." },
    "caption":     { "type": "string" },
    "attribution": { "type": "string",
                     "description": "Optional credit chip inside the frame (bottom-right)." },
    "ken_burns":   { "type": "boolean", "default": false },
    "direction":   { "enum": ["in", "out", "left", "right", "up", "down"] },
    "zoom":        { "type": "number", "minimum": 0, "maximum": 1 },
    "media_type":  { "enum": ["auto", "image", "video"] },
    "width":       { "type": "number", "exclusiveMinimum": 0 },
    "height":      { "type": "number", "exclusiveMinimum": 0 },
    "size":        { "$ref": "../scene_schema.json#/definitions/size_role" },
    "timing":      { "$ref": "../scene_schema.json#/definitions/timing_name" },
    "effect":      { "enum": ["fade-in"] },
    "role":        { "$ref": "../scene_schema.json#/definitions/role_name" },
    "slot":        { "$ref": "../scene_schema.json#/definitions/slot_name" },
    "anchor":      { "$ref": "../scene_schema.json#/definitions/anchor_string" }
  },
  "additionalProperties": false
}
