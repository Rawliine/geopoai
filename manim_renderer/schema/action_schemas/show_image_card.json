{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showImageCard.params",
  "type": "object",
  "required": ["id", "image", "source"],
  "properties": {
    "id":        { "$ref": "../scene_schema.json#/definitions/id_string" },
    "image":     { "type": "string", "minLength": 1,
                   "description": "Raster path: absolute, repo-root relative, or a bare name under assets/images/." },
    "source":    { "type": "string", "minLength": 1,
                   "description": "Mandatory attribution/credit, rendered as a chip." },
    "width":     { "type": "number", "exclusiveMinimum": 0 },
    "height":    { "type": "number", "exclusiveMinimum": 0 },
    "zoom":      { "type": "number", "minimum": 0, "maximum": 1 },
    "direction": { "enum": ["in", "out", "left", "right", "up", "down"] },
    "mask":      { "type": "string",
                   "description": "Optional 'country:<name>' — deferred to the map renderer; here the frame is rectangular/rounded." },
    "size":      { "$ref": "../scene_schema.json#/definitions/size_role" },
    "timing":    { "$ref": "../scene_schema.json#/definitions/timing_name" },
    "effect":    { "enum": ["fade-in"] },
    "role":      { "$ref": "../scene_schema.json#/definitions/role_name" },
    "slot":      { "$ref": "../scene_schema.json#/definitions/slot_name" },
    "anchor":    { "$ref": "../scene_schema.json#/definitions/anchor_string" }
  },
  "additionalProperties": false
}
