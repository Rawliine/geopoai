{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManimScene",
  "type": "object",
  "required": ["renderer", "format", "quality", "scene", "timeline"],
  "properties": {
    "renderer": { "const": "manim" },
    "format": { "enum": ["horizontal", "vertical"] },
    "quality": { "enum": ["preview", "draft", "full"] },
    "scene": {
      "type": "object",
      "required": ["layout", "duration"],
      "properties": {
        "layout": { "$ref": "#/definitions/layout_name" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "theme": { "type": "string" }
      },
      "additionalProperties": true
    },
    "slots": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/event" }
    },
    "overlays": {
      "type": "array",
      "items": { "$ref": "#/definitions/event" }
    },
    "timeline": {
      "type": "array",
      "items": { "$ref": "#/definitions/event" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "event": {
      "type": "object",
      "required": ["at", "action"],
      "properties": {
        "at": { "type": "number", "minimum": 0 },
        "action": { "type": "string" },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },

    "id_string": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case ID (lowercase alphanumeric + hyphens)."
    },
    "anchor_string": {
      "type": "string",
      "pattern": "^(above|below|left-of|right-of|inside):[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Token + ':' + kebab-case id of an existing component."
    },
    "timing_name": {
      "enum": ["instant", "snap", "fast", "normal", "slow", "dramatic", "crawl"]
    },
    "size_role": {
      "enum": ["small", "medium", "large"]
    },
    "color_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Palette key (e.g. 'actor_a', 'highlight'). Hex codes are not allowed."
    },
    "entrance_effect": {
      "enum": [
        "fade-in", "write-in", "draw-out",
        "grow-up", "grow-down",
        "slide-left", "slide-right", "slide-up", "slide-down",
        "level-by-level", "count-up"
      ]
    },
    "emphasis_effect": {
      "enum": ["pulse", "highlight"]
    },
    "exit_effect": {
      "enum": ["fade-out", "dissolve"]
    },
    "value_format": {
      "enum": [
        "int", "decimal", "pct", "k", "m",
        "currency", "signed", "duration", "ratio", "scientific"
      ],
      "description": "Numeric display format. See manim_renderer/components/data_viz/_value_format.py."
    },
    "color_role": {
      "enum": [
        "actor_a", "actor_b", "actor_c", "actor_d", "actor_e",
        "positive", "negative", "neutral", "highlight", "contested",
        "text_primary", "text_secondary", "text_accent", "border", "surface"
      ],
      "description": "Palette key. Resolved against ACTORS+SEMANTIC+UI in theme/palette.py."
    },
    "layout_name": {
      "enum": [
        "hero",
        "split", "stacked",
        "data-left", "data-top",
        "trio", "trio-stack",
        "title-body"
      ],
      "description": "Layout name. Some are format-specific (split=horizontal, stacked=vertical); the validator's LAYOUT_FORMATS map enforces compatibility."
    },
    "callout_style": {
      "enum": ["neon", "card", "glass", "bracket"],
      "description": "Visual style for CalloutBox. Phase 1.5 default is 'neon'. See manim_renderer/components/narrative/_callout_styles.py."
    }
  }
}
