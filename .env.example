# GeoPoAI environment variables — copy to .env and fill in values.
# Stock keys marked REQUIRED below must be set for that source to participate
# in the cascade; missing keys skip the source with a logged reason.

# ── Map renderer (not broll; included for one-stop setup) ───────────────────
MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── GPU sessions (infra/ — pipeline/gpu_session.py) ─────────────────────────
# Verda Cloud API credentials (Dashboard → Keys → Cloud API Credentials).
# Required for: interactive wizard, `gpus --all-locations`, live availability
# filtering, and the VM dead-man self-terminate backstop.
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=

# ── Stock source API keys ───────────────────────────────────────────────────
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Free key: https://pixabay.com/api/docs/ — the one stock key commonly missing
PIXABAY_API_KEY=

# Free key: https://api.dvidshub.net/ — US DoD public-domain footage (DVIDS)
DVIDS_API_KEY=

# LoC, Wikimedia, Archive.org, NASA Image Library: no key required.

# ── Vision verifier ─────────────────────────────────────────────────────────
# Backend: claude_cli (default) | checkpoint | api | clip_only | heuristic
# Default claude_cli uses your Claude Code subscription — no API key needed.
BROLL_VERIFIER=claude_cli

# OPTIONAL — only for BROLL_VERIFIER=api (unattended batch scale).
# Default path is Claude Code subscription auth via `claude -p`.
ANTHROPIC_API_KEY=

# Model override when using BROLL_VERIFIER=api
BROLL_VERIFIER_MODEL=claude-sonnet-4-6

# Stricter CLIP/heuristic threshold when BROLL_VERIFIER=clip_only (default 0.45)
BROLL_CLIP_ONLY_THRESHOLD=0.45

# ── CLIP prefilter ──────────────────────────────────────────────────────────
# Force open_clip backend (requires torch + open_clip install)
BROLL_PREFILTER=
BROLL_USE_CLIP=0

# ── ComfyUI (AI generation path) ────────────────────────────────────────────
BROLL_COMFYUI_URL=http://127.0.0.1:8188
BROLL_COMFYUI_JOB_TIMEOUT_SEC=600

# ── Cache / rate-limit toggles (dev/test) ───────────────────────────────────
BROLL_CACHE_TTL_SEC=21600
BROLL_NO_CACHE=0
BROLL_NO_RATE_LIMIT=0
BROLL_NO_AI_CACHE=0
